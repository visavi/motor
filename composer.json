{
    "name": "visavi/motor",
    "description": "cms",
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "guzzlehttp/guzzle": "^8.1",
        "intervention/image": "^4.3",
        "league/plates": "^3.5",
        "monolog/monolog": "^3.10",
        "php-di/slim-bridge": "^3.3",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.11",
        "symfony/console": "^8.1",
        "symfony/mailer": "^8.1",
        "visavi/captcha": "^4.0",
        "visavi/cleanup": "^2.2",
        "visavi/motor-orm": "^6.0",
        "symfony/cache": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "filp/whoops": "^2.15",
        "symfony/var-dumper": "^8.1",
        "deployer/deployer": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "license": "GPL-3.0-only"
}
